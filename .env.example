# Supabase → кнопка Connect вверху дашборда (или Settings)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Новый ключ: Settings → API Keys → Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Старые проекты: Settings → API Keys → вкладка Legacy API Keys → anon public
# Достаточно любой ОДНОЙ из двух строк — publishable или anon.
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
